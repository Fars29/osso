{
  "manifest_version": 3,
  "name": "Osso",
  "version": "0.1.0",
  "description": "Just the bone. Every page arrives with its filler faded and its substance left in the author's own words. Nothing is hidden, nothing is rewritten.",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Osso",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "css": ["osso.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["https://api.typesafe.ai/*"],
  "commands": {
    "toggle-site": {
      "suggested_key": { "default": "Alt+Shift+O" },
      "description": "Turn Osso on or off for this site"
    }
  }
}
